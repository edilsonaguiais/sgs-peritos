# --- Instagram (Meta for Developers > seu app > Instagram > Configuração da API com login do Instagram)
IG_ACCESS_TOKEN=cole_o_token_de_longa_duracao
IG_APP_SECRET=chave_secreta_do_app_instagram
IG_VERIFY_TOKEN=invente_uma_frase_secreta_e_use_a_mesma_no_painel
IG_USER_ID=id_da_sua_conta_profissional
GRAPH_VERSAO=v23.0

# --- Claude (https://console.anthropic.com > API Keys)
ANTHROPIC_API_KEY=sk-ant-...
MODELO=claude-opus-5-5
# low | medium | high  (mais alto = respostas mais pensadas, mais caras)
ESFORCO=medium

# --- Comportamento
# segundos esperando o lead terminar de digitar antes de responder
ESPERA_AGRUPAR_S=8
# quando você responde um lead pelo app, o agente sai daquela conversa por este tempo
PAUSA_HUMANO_HORAS=24
# URL que recebe um POST quando um lead precisa de humano (Make, Zapier, n8n, Slack...)
NOTIFICAR_URL=
# senha para consultar /leads
ADMIN_TOKEN=troque_esta_senha
# 1 = não envia nada ao Instagram, só mostra no log
MODO_TESTE=0
